# For running the backend without Docker: copy to backend/.env and fill in.
# Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Defaults match `docker compose up postgres redis`
DATABASE_URL=postgresql+asyncpg://aeo:aeo@localhost:5432/aeo
REDIS_URL=redis://localhost:6379/0

# Optional
# LLM_MODEL=gemini-3.8-flash
# RATE_LIMIT_PER_HOUR=10
# CORS_ORIGINS=["http://localhost:3000"]
